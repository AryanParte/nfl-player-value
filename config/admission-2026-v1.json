{
  "decided_at": "2026-11-02T19:53:56+00:00",
  "decision_version": "2026-11-02-v1",
  "findings": {
    "defense_accounting": {
      "applies_to": [
        "accounting"
      ],
      "evidence_refs": [
        "defense_evidence"
      ],
      "reason": "Historical rich/degraded outcome accounting retains team/context/residual and negative defensive outcomes. This is not proof of individual allocation.",
      "status": "passed"
    },
    "defense_attribution": {
      "applies_to": [
        "attribution"
      ],
      "evidence_refs": [
        "defense_evidence"
      ],
      "reason": "Neither defender model passes the prespecified predictive-increment criterion; aggregation loses identification. Passing prediction would still not prove attribution.",
      "status": "failed"
    },
    "defense_benchmark": {
      "applies_to": [
        "benchmark"
      ],
      "evidence_refs": [
        "defense_evidence",
        "decision_record"
      ],
      "reason": "No fitted positional defensive first-unit contrast or both benchmark sensitivities are implemented and validated.",
      "status": "not_evaluated"
    },
    "defense_comparability": {
      "applies_to": [
        "comparability"
      ],
      "evidence_refs": [
        "defense_evidence",
        "decision_record"
      ],
      "reason": "No defensive positional CAVAA module has demonstrated common-unit comparability to an admitted offensive module.",
      "status": "not_evaluated"
    },
    "defense_data": {
      "applies_to": [
        "data"
      ],
      "evidence_refs": [
        "defense_evidence",
        "explorer_evidence"
      ],
      "reason": "The historical lineup experiment does not certify current-season role/workload coverage. Explorer event counts do not measure pressures, coverage deterrence or off-ball value.",
      "status": "insufficient"
    },
    "defense_denominator": {
      "applies_to": [
        "denominator"
      ],
      "evidence_refs": [
        "explorer_evidence",
        "eligibility_contract"
      ],
      "reason": "No verified permitted live defensive workload and general stint denominator supports individual-value qualification.",
      "status": "not_evaluated"
    },
    "defense_uncertainty": {
      "applies_to": [
        "uncertainty"
      ],
      "evidence_refs": [
        "defense_evidence",
        "decision_record"
      ],
      "reason": "Prediction-error intervals are not individual-value uncertainty; no calibrated positional player-minus-benchmark interval is available.",
      "status": "not_evaluated"
    },
    "offense_accounting": {
      "applies_to": [
        "accounting"
      ],
      "evidence_refs": [
        "contrast_evidence"
      ],
      "reason": "Independent numerical checks and component reconstruction preserve shared/team terms and negative outcomes. This establishes arithmetic only, not uniquely correct allocation.",
      "status": "passed"
    },
    "offense_attribution": {
      "applies_to": [
        "attribution"
      ],
      "evidence_refs": [
        "offense_evidence",
        "contrast_evidence",
        "transition_evidence"
      ],
      "reason": "Limited identity increment, strong penalty sensitivity and sparse selected QB transitions do not establish individual contribution under a comparable positional counterfactual.",
      "status": "insufficient"
    },
    "offense_benchmark": {
      "applies_to": [
        "benchmark"
      ],
      "evidence_refs": [
        "contrast_evidence",
        "benchmark_contract"
      ],
      "reason": "First-unit and both sensitivity contrasts run, but retrospective source availability and missing later historical RB/WR/TE first-unit cells do not validate the full release population.",
      "status": "insufficient"
    },
    "offense_comparability": {
      "applies_to": [
        "comparability"
      ],
      "evidence_refs": [
        "offense_evidence",
        "contrast_evidence",
        "decision_record"
      ],
      "reason": "Observed QB/RB/target components omit different contributions and condition on endogenous observed roles; no cross-position comparison has passed validation.",
      "status": "insufficient"
    },
    "offense_data": {
      "applies_to": [
        "data"
      ],
      "evidence_refs": [
        "offense_evidence",
        "roster_evidence",
        "contrast_evidence"
      ],
      "reason": "Observed actor roles and exact-week roster positions do not cover full contributions, off-ball play or comparable player-created context. The current archive is retrospective Week 6 evidence.",
      "status": "insufficient"
    },
    "offense_denominator": {
      "applies_to": [
        "denominator"
      ],
      "evidence_refs": [
        "roster_evidence",
        "contrast_evidence",
        "eligibility_contract"
      ],
      "reason": "The selected full-observed single-team subset does not establish general stints, missed games, late signings, trades or position-change denominators.",
      "status": "insufficient"
    },
    "offense_uncertainty": {
      "applies_to": [
        "uncertainty"
      ],
      "evidence_refs": [
        "calibration_evidence"
      ],
      "reason": "The primary conditional intervals fail the prespecified stronger-signal simulations despite near-nominal prior-matched coverage. These failures are not measured real-player error rates.",
      "status": "failed"
    },
    "unimplemented": {
      "applies_to": [
        "data",
        "benchmark",
        "denominator",
        "accounting",
        "attribution",
        "uncertainty",
        "comparability"
      ],
      "evidence_refs": [
        "decision_record"
      ],
      "reason": "No individual model and validated contribution/benchmark/workload/uncertainty comparison are implemented for this module. Missing value is not zero.",
      "status": "not_evaluated"
    }
  },
